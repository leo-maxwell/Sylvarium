---
import "@/styles/global.css";
import SiteBanner from "@/components/SiteBanner.astro";
import NavBar from "@/components/navigation/NavBar.astro";
import { htmlLangByRouteLocale, type RouteLocale } from "@/i18n/locales";

interface Props {
  title?: string;
  locale: RouteLocale;
}

// TODO: different title with different language settings
const { title = "Sylvarium 青枝录", locale } = Astro.props;

const htmlLang = htmlLangByRouteLocale[locale];
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>

  <body>
    <SiteBanner />
    <NavBar locale={locale} />
    <slot />
  </body>
</html>
