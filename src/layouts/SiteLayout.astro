---
import "@/styles/global.css";
import { htmlLangByRouteLocale, type RouteLocale } from "@/i18n/locales";

interface Props {
  title?: string;
  locale: RouteLocale;
}

const { title = "Sylvarium Playground", locale } = Astro.props;

const htmlLang = htmlLangByRouteLocale[locale];
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>

  <body>
    <slot />
  </body>
</html>
