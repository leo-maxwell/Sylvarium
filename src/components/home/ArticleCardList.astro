---
import { getPublishedArticles } from "@/lib/articles";
import ArticleCard from "./ArticleCard.astro";
import { useTranslations } from "@/i18n";
import type { RouteLocale } from "@/i18n/locales";

interface Props {
  locale: RouteLocale;
}

const { locale } = Astro.props;
const strings = useTranslations(locale);

const articles = await getPublishedArticles();
---

<section id="articles" aria-labelledby="articles-heading">
  <h1 id="articles-heading">
    {strings.home.recentPosts}
  </h1>

  <ul class="article-list">
    {
      articles.map(article => (
        <li>
          <ArticleCard article={article} locale={locale} />
        </li>
      ))
    }
  </ul>
</section>

<style>
  section {
    scroll-margin-top: calc(var(--apple-navbar-height) + 1rem);
  }
  h1 {
    margin: 0 0 0.5rem;
    font-family: var(--font-ui);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--site-color-text);
  }
  .article-list {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
