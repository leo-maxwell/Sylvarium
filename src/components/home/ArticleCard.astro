---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { htmlLangByRouteLocale, type RouteLocale } from "@/i18n/locales";

interface Props {
  article: CollectionEntry<"articles">;
  locale: RouteLocale;
}

const { article, locale } = Astro.props;
const { title, description, pubDatetime, category, tags, cover, timezone } =
  article.data;

const basePath = import.meta.env.BASE_URL.replace(/\/?$/, "/");

const articlePath = article.id
  .split("/")
  .map(segment => encodeURIComponent(segment))
  .join("/");

const href = `${basePath}posts/${articlePath}`;

const date = new Intl.DateTimeFormat(htmlLangByRouteLocale[locale], {
  year: "numeric",
  month: "short",
  day: "numeric",
  timeZone: timezone ?? "UTC",
}).format(pubDatetime);
---

<!--
TODO: optimize cover width
TODO:
-->
<article class="article-card">
  {
    cover && (
      <Image
        class="article-cover"
        src={cover}
        alt=""
        width={288}
        loading="lazy"
      />
    )
  }

  <div class="article-card-content">
    <header class="article-header">
      <h2 class="article-title">
        <a href={href}>{title}</a>
      </h2>

      <time datetime={pubDatetime.toISOString()}>
        {date}
      </time>
    </header>

    <p class="article-subtitle">{description}</p>

    <div class="article-metadata">
      <span class="article-category">{category}</span>
      {
        tags.map((tag, index) => (
          <span class="article-tag">
            {index === 0 && (
              <span class="article-separator" aria-hidden="true" />
            )}
            <span class="article-tag-text">{tag}</span>
          </span>
        ))
      }
    </div>
  </div>
</article>

<style>
  .article-card {
    box-sizing: border-box;
    display: flex;
    align-items: flex-start;
    gap: 1.125rem;

    width: 100%;
    padding: 1.25rem;

    border: 1px solid rgb(0 0 0 / 0.08);
    border-radius: 6px;

    background: rgb(255 255 255 / 0.65);
  }
  .article-cover {
    flex: 0 0 auto;
    display: block;

    width: 8rem;
    height: 8rem;
    object-fit: cover;

    border-radius: 3px;
  }
  .article-card-content {
    flex: 1;
    min-width: 0;
  }
  .article-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) max-content;
    align-items: baseline;
    gap: 0.875rem;
  }
  .article-title {
    margin: 0;
    font-family: var(--font-sans-secondary);
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }
  .article-title a {
    color: inherit;
    text-decoration: none;
  }
  .article a:focus-visible {
    outline: 2px solid #007aff;
    outline-offset: 3px;
  }
  .article-header time {
    white-space: nowrap;
    font-family: var(--font-sans-secondary);
    font-size: 0.8125rem;
    line-height: 1.6;
    color: #62656b;
  }
  .article-subtitle {
    margin: 0.5rem 0 0;
    font-family: var(--font-ui);
    font-size: 0.9375rem;
    line-height: 1.75;

    color: #595c61;
    overflow-wrap: anywhere;
  }
  .article-metadata {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.375rem 0.875rem;
    margin-top: 0.875rem;
    font-family: var(--font-sans-secondary);
    font-size: 0.8125rem;
    line-height: 1.6;
    color: #62656b;
  }
  .article-category {
    flex: 0 0 auto;
    white-space: nowrap;
    color: var(--color-text);
  }
  .article-tag {
    display: inline-flex;
    align-items: baseline;
    gap: 0.875rem;
    max-width: 100%;
    min-width: 0;
  }
  .article-tag-text {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .article-separator {
    flex: 0 0 auto;
    align-self: center;
    width: 1px;
    height: 0.9em;
    background: #a0a3a8;
  }
</style>
