---
import { Languages, SunMoon } from "@lucide/astro";
---

<nav class="navbar" aria-label="Primary navigation">
  <div class="navbar-inner">
    <div class="nav-links">
      <a href="#home">Home</a>
      <a href="#articles">Articles</a>
      <a href="#about">About</a>
    </div>

    <div class="nav-utilities">
      <button type="button" aria-label="Switch language"
        ><Languages
          size="var(--navbar-icon-size)"
          stroke-width="var(--navbar-icon-stroke-width)"
        /></button
      >
      <button type="button" aria-label="Switch theme"
        ><SunMoon
          size="var(--navbar-icon-size)"
          stroke-width="var(--navbar-icon-stroke-width)"
        /></button
      >
    </div>
  </div>
</nav>

<style>
  .navbar {
    position: sticky;
    top: 0;
    z-index: 100;

    height: var(--apple-navbar-height);

    background: var(--apple-navbar-bg-color);

    backdrop-filter: var(--apple-navbar-backdrop);
    -webkit-backdrop-filter: var(--apple-navbar-backdrop);

    font-family: var(--font-ui);
  }

  .navbar-inner {
    width: 100%;
    max-width: var(--site-shell-width);
    margin-inline: auto;
    padding-inline: var(--site-gutter);

    height: 100%;

    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 1rem;
  }

  .nav-links,
  .nav-utilities {
    display: flex;
    align-items: center;
    gap: var(--navbar-button-gap);
  }

  a,
  button {
    min-height: var(--apple-navbar-height);
    padding-inline: var(--apple-navbar-button-horizontal-padding);

    display: inline-flex;
    align-items: center;

    border: 0;

    color: var(--navbar-button-text-color);
    font-size: var(--navbar-button-font-size);
    font-weight: var(--apple-navbar-button-font-weight);
    line-height: var(--apple-navbar-button-line-height);
    letter-spacing: var(--apple-navbar-button-letter-spacing);

    background: transparent;

    text-decoration: none;
    cursor: pointer;

    transition: color 120ms ease;
  }

  a:hover,
  button:hover {
    color: var(--apple-navbar-text-color-hover);
  }

  a:focus-visible,
  button:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }
</style>
