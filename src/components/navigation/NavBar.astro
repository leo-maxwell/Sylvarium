---
import { Languages, SunMoon } from "@lucide/astro";
import type { RouteLocale } from "@/i18n/locales";
import { useTranslations } from "@/i18n";

interface Props {
  locale: RouteLocale;
}

const { locale } = Astro.props;
const strings = useTranslations(locale);
---

<nav class="navbar" aria-label={strings.a11y.primaryNavigation}>
  <div class="navbar-inner">
    <div class="nav-links">
      <a href="#home">{strings.nav.home}</a>
      <a href="#articles">{strings.nav.articles}</a>
      <a href="#subscription">{strings.nav.subscription}</a>
      <a href="#blogroll">{strings.nav.blogroll}</a>
      <a href="#about">{strings.nav.about}</a>
    </div>

    <div class="nav-utilities">
      <button
        class="language-trigger"
        type="button"
        aria-label={strings.a11y.switchLanguage}
        popovertarget="language-menu"
        ><Languages
          size="var(--navbar-icon-size)"
          stroke-width="var(--navbar-icon-stroke-width)"
        /></button
      >

      <div
        id="language-menu"
        class="dropdown-menu language-menu"
        popover="auto"
      >
        <fieldset class="dropdown-options">
          <legend class="sr-only">
            {strings.a11y.switchLanguage}
          </legend>
          <label class="dropdown-item">
            <input
              class="dropdown-radio"
              type="radio"
              name="language-preview"
              value="en"
              checked={locale === "en"}
            />
            <span lang="en">English</span>
            <span class="dropdown-check" aria-hidden="true">✓</span>
          </label>

          <label class="dropdown-item">
            <input
              class="dropdown-radio"
              type="radio"
              name="language-preview"
              value="sc"
              checked={locale === "sc"}
            />
            <span lang="zh-Hans">简体中文</span>
            <span class="dropdown-check" aria-hidden="true">✓</span>
          </label>
        </fieldset>
      </div>
      <button
        class="theme-trigger"
        type="button"
        aria-label={strings.a11y.switchTheme}
        popovertarget="theme-menu"
        ><SunMoon
          size="var(--navbar-icon-size)"
          stroke-width="var(--navbar-icon-stroke-width)"
        /></button
      >
      <div id="theme-menu" class="dropdown-menu theme-menu" popover="auto">
        <fieldset class="dropdown-options">
          <legend class="sr-only">
            {strings.a11y.switchTheme}
          </legend>
          <label class="dropdown-item">
            <input
              class="dropdown-radio"
              type="radio"
              name="theme-preview"
              value="system"
              checked
            />
            <span>System</span>
            <span class="dropdown-check" aria-hidden="true">✓</span>
          </label>

          <label class="dropdown-item">
            <input
              class="dropdown-radio"
              type="radio"
              name="theme-preview"
              value="light"
            />
            <span>Light</span>
            <span class="dropdown-check" aria-hidden="true">✓</span>
          </label>

          <label class="dropdown-item">
            <input
              class="dropdown-radio"
              type="radio"
              name="theme-preview"
              value="dark"
            />
            <span>Dark</span>
            <span class="dropdown-check" aria-hidden="true">✓</span>
          </label>
        </fieldset>
      </div>
    </div>
  </div>
</nav>

<style>
  .navbar {
    position: sticky;
    top: 0;
    z-index: 100;

    height: var(--apple-navbar-height);

    background: var(--apple-navbar-bg-color);

    backdrop-filter: var(--apple-navbar-backdrop);
    -webkit-backdrop-filter: var(--apple-navbar-backdrop);

    font-family: var(--font-ui);
  }

  .navbar-inner {
    width: 100%;
    max-width: var(--site-shell-width);
    margin-inline: auto;
    padding-inline: var(--site-gutter);

    height: 100%;

    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 1rem;
  }

  .nav-links,
  .nav-utilities {
    display: flex;
    align-items: center;
    gap: var(--navbar-button-gap);
  }

  a,
  button {
    min-height: var(--apple-navbar-height);
    padding-inline: var(--apple-navbar-button-horizontal-padding);

    display: inline-flex;
    align-items: center;

    border: 0;

    color: var(--navbar-button-text-color);
    font-size: var(--navbar-button-font-size);
    font-weight: var(--apple-navbar-button-font-weight);
    line-height: var(--apple-navbar-button-line-height);
    letter-spacing: var(--apple-navbar-button-letter-spacing);

    background: transparent;

    text-decoration: none;
    cursor: pointer;

    transition: color 120ms ease;
  }

  a:hover,
  button:hover {
    color: var(--apple-navbar-text-color-hover);
  }

  a:focus-visible,
  button:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  .dropdown-menu {
    min-width: 10rem;
    margin: auto;

    color: var(--color-text);
    background: rgb(220 220 220 / 0.6);
    backdrop-filter: var(--apple-navbar-backdrop);
    -webkit-backdrop-filter: var(--apple-navbar-backdrop);

    /* just a hint of rounded corner is enough */
    border-radius: 0 0 1px 1px;

    font-family: var(--font-ui);
  }

  @keyframes dropdown-menu-enter {
    from {
      opacity: 0;
      transform: translateY(-3px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .dropdown-menu:popover-open {
    animation: dropdown-menu-enter 140ms cubic-bezier(0.2, 0, 0, 1);
  }

  @media (prefers-reduced-motion: reduce) {
    .dropdown-menu:popover-open {
      animation: none;
    }
  }

  .dropdown-options {
    display: grid;
    gap: 0.125rem;

    margin: 0;
    padding: 0;
    border: 0;
  }

  .dropdown-item {
    min-height: 2rem;
    padding-inline: 0.5rem;
    display: grid;
    grid-template-columns: 1fr 1rem;
    align-items: center;
    gap: 1rem;
    cursor: pointer;

    transition: background-color 90ms ease-out;
  }

  .dropdown-item:hover {
    /*background: var(--color-glass-hover);*/
    background: rgb(255 255 255 / 0.25);
  }

  .dropdown-item:active {
    background-color: rgb(0 0 0 / 0.09);
  }

  .dropdown-radio {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .dropdown-check {
    visibility: hidden;
    text-align: center;
  }

  .dropdown-radio:checked ~ .dropdown-check {
    visibility: visible;
  }

  .dropdown-item:has(.dropdown-radio:focus-visible) {
    outline: 2px solid currentColor;
    outline-offset: 1px;
  }

  .language-trigger {
    anchor-name: --language-menu-trigger;
  }

  .theme-trigger {
    anchor-name: --theme-menu-trigger;
  }

  @supports (position-area: block-end span-inline-start) {
    .dropdown-menu {
      position: fixed;

      /* positioned under the trigger, takes up the room at the left of trigger */
      /* `justify-self: end` to align the right edge to the trigger */
      position-area: block-end span-inline-start;
      justify-self: end;
      align-self: start;

      /* sticks to the navbar */
      margin: 0 0 0 0;

      /* in case the room under the trigger is not enough, flip it to the top */
      position-try-fallbacks: flip-block;
    }

    .language-menu {
      position-anchor: --language-menu-trigger;
    }

    .theme-menu {
      position-anchor: --theme-menu-trigger;
    }
  }
</style>
