  </main>
</PlaygroundLayout>

<style>
  .demo-banner {
    min-height: var(--height-top-banner);

    display: grid;
    place-items: center;

    padding: 3rem, 1rem;

    text-align: center;

    background:
      radial-gradient(
        circle at 30% 20%,
        rgb(255 255 255 / 0.9),
        transparent 35%
      ),
      linear-gradient(135deg, #d9e4d1, #b7c9ac);
  }

  .demo-banner p {
    margin: 0.5rem;
  }

  .demo-banner h1 {
    margin: 0;
    font-size: clamp(3rem, 10vw, 7rem);
    font-weight: 500;
  }

  .demo-content {
    width: min(100% - 2rem, 48rem);

    margin-inline: auto;
    padding-block: 5rem;
  }

  .demo-content h1 {
    font-size: clamp(2rem, 5vw, 4rem);
    line-height: 1.1;
  }

  .demo-content h2 {
    margin-top: 4rem;
  }

  .demo-content p {
    font-size: 1.125rem;
    line-height: 1.8;
  }

  .eyebrow {
    font-size: 0.75rem;
    letter-spacing: 0.15rem;
  }

  .spacer {
    height: 70vhl;
  }
</style>
