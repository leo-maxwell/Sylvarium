---
import PlaygroundLayout from "@/layouts/PlaygroundLayout.astro";
import NavBar from "@/components/navigation/NavBar.astro";
import { requireRouteLocale, routeLocales } from "@/i18n/locales";

export function getStaticPaths() {
  return routeLocales.map(locale => ({
    params: { locale },
  }));
}

const locale = requireRouteLocale(Astro.currentLocale);
---

<PlaygroundLayout title="Navbar Playground" locale={locale}>
  <header class="demo-banner">
    <div>
      <p>Sylvarium</p>
      <h1>青枝录</h1>
      <p>Temporary banner</p>
    </div>
  </header>
  <NavBar locale={locale} />

  <main class="demo-content">
    <article>
      <p class="eyebrow">PLAYGROUND</p>

      <h1>Testing the navigation bar</h1>

      <p style="font-family: var(--font-content);">
        This page exists only to give us 华文中宋中文测试永字八法 enough content
        to scroll, inspect the glass effect, and experiment with the navigation
        bar.
      </p>

      <h2>Lorem ipsum</h2>

      <p style="font-family: var(--font-mono);">
        Lorem ipsum dolor sit amet, consectetur adipiscing elit. Pellentesque
